# syntax=docker/dockerfile:1
# Backlogfit self-hosted server image.
#   podman build --format docker -f apps/server/Containerfile -t backlogfit .
#   docker build -f apps/server/Containerfile -t backlogfit .
# Build context is the repository root. `--format docker` keeps HEALTHCHECK under Podman
# (the OCI image format has no healthcheck field).

ARG BUILD_IMAGE=docker.io/library/node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f
ARG RUNTIME_IMAGE=gcr.io/distroless/nodejs24-debian12:nonroot@sha256:14d42e2511532589a7c7e01a753667a74fcc96266e137e8125006b87b0c32d0a

# ---- toolchain -----------------------------------------------------------------------------
FROM ${BUILD_IMAGE} AS toolchain
ENV CI=true \
    npm_config_update_notifier=false \
    pnpm_config_enable_global_virtual_store=false
RUN npm install --global --no-fund --no-audit pnpm@11.18.0
WORKDIR /src

# ---- web build (skipped while apps/web does not exist) -------------------------------------
FROM toolchain AS web
COPY . .
RUN if [ -f apps/web/package.json ]; then \
      pnpm install --frozen-lockfile --filter "@backlogfit/web..." && \
      pnpm --filter @backlogfit/web build; \
    fi && \
    mkdir -p apps/web/build

# ---- production dependencies + runtime file set --------------------------------------------
FROM toolchain AS prod
COPY . .
RUN pnpm install --prod --frozen-lockfile --filter "@backlogfit/server..."
# Only what the server needs at runtime: TS sources run with Node's type stripping.
RUN set -eu; \
    mkdir -p /out/app /out/data; \
    cp package.json /out/app/; \
    cp -a node_modules /out/app/; \
    for p in packages/core packages/security apps/server; do \
      mkdir -p "/out/app/$p/node_modules"; \
      cp -a "$p/package.json" "$p/src" "/out/app/$p/"; \
      if [ -d "$p/node_modules" ]; then cp -a "$p/node_modules/." "/out/app/$p/node_modules/"; fi; \
    done; \
    chown 65532:65532 /out/data
COPY --from=web /src/apps/web/build /out/app/apps/web/build

# ---- runtime -------------------------------------------------------------------------------
FROM ${RUNTIME_IMAGE}
LABEL org.opencontainers.image.title="backlogfit" \
      org.opencontainers.image.description="Privacy-first story point estimation (self-hosted server)" \
      org.opencontainers.image.source="https://github.com/Sinet2000/backlogfit" \
      org.opencontainers.image.licenses="Apache-2.0"
WORKDIR /app
COPY --from=prod /out/app /app
COPY --from=prod --chown=65532:65532 /out/data /data
ENV NODE_ENV=production \
    PORT=8080 \
    DATA_DIR=/data \
    WEB_DIR=/app/apps/web/build
USER 65532:65532
VOLUME ["/data"]
EXPOSE 8080
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/nodejs/bin/node", "/app/apps/server/src/healthcheck.ts"]
ENTRYPOINT ["/nodejs/bin/node", "--disable-warning=ExperimentalWarning"]
CMD ["/app/apps/server/src/main.ts"]
