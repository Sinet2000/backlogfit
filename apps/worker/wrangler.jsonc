{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backlogfit",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Privacy: no platform logs, traces, Logpush or tail workers.
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "logpush": false,
  "preview_urls": false,
  // No Wrangler CLI usage telemetry.
  "send_metrics": false,

  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/ws/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],

  // Keep `limit` equal to ROOM_CREATE_PER_MIN (the binding cannot read vars).
  // UPGRADE_LIMITER: WebSocket upgrades per client (each one wakes a Durable Object); keep it
  // equal to WS_UPGRADES_PER_MIN.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "UPGRADE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],

  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "NODE_ENV": "development",
    "DEFAULT_LIFETIME_HOURS": "2",
    "MAX_LIFETIME_HOURS": "8",
    "IDLE_TIMEOUT_MINUTES": "30",
    "MAX_PARTICIPANTS": "50",
    "MAX_TASKS": "500",
    "MAX_MESSAGE_BYTES": "16384",
    "RATE_MSGS_PER_SEC": "20",
    "RATE_BURST": "40",
    "ROOM_CREATE_PER_MIN": "10",
    "PASSCODE_MAX_ATTEMPTS": "5",
    "HELLO_TIMEOUT_SECONDS": "20",
    "SOCKET_TIMEOUT_SECONDS": "90",
    "WS_UPGRADES_PER_MIN": "120"
  },

  "env": {
    "production": {
      "routes": [{ "pattern": "backlogfit.com", "custom_domain": true }],
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
      },
      "ratelimits": [
        {
          "name": "CREATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "UPGRADE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://backlogfit.com",
        "ALLOWED_ORIGINS": "",
        "NODE_ENV": "production",
        "DEFAULT_LIFETIME_HOURS": "2",
        "MAX_LIFETIME_HOURS": "8",
        "IDLE_TIMEOUT_MINUTES": "30",
        "MAX_PARTICIPANTS": "50",
        "MAX_TASKS": "500",
        "MAX_MESSAGE_BYTES": "16384",
        "RATE_MSGS_PER_SEC": "20",
        "RATE_BURST": "40",
        "ROOM_CREATE_PER_MIN": "10",
        "PASSCODE_MAX_ATTEMPTS": "5",
        "HELLO_TIMEOUT_SECONDS": "20",
        "SOCKET_TIMEOUT_SECONDS": "90",
        "WS_UPGRADES_PER_MIN": "120"
      }
    }
  }
}
