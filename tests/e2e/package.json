{
  "name": "@backlogfit/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end, accessibility and visual regression tests for Backlogfit (Playwright).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:smoke": "playwright test --project=firefox --project=webkit",
    "e2e:visual": "playwright test --project=visual",
    "e2e:update-snapshots": "playwright test --project=visual --update-snapshots",
    "screenshots": "playwright test --config=playwright.screenshots.config.ts",
    "install-browsers": "playwright install chromium firefox webkit",
    "typecheck": "tsc --noEmit",
    "test": "node --test unit/*.test.ts"
  },
  "dependencies": {
    "@backlogfit/core": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5"
  }
}
